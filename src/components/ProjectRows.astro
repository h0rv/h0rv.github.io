---
import type { CollectionEntry } from "astro:content";
import { getList } from "../lib/content";

interface Props {
  projects?: CollectionEntry<"projects">[];
}

const projects = Astro.props.projects ?? (await getList("projects"));
---

<ul class="rows">
  {projects.map(({ data: p }) => (
    <li class="link-row">
      <span class="meta">{p.year}</span>
      <a class="main" href={p.site ?? p.docs ?? p.repo} title={p.description}>{p.name}</a>
      {(p.site || p.docs) && (
        <span class="links mono">
          {p.site && p.docs && <a href={p.docs}>docs ↗</a>}
          <a href={p.repo}>source</a>
        </span>
      )}
    </li>
  ))}
</ul>
