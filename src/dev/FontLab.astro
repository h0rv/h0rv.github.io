---
// Dev-only font specimen page at /__fonts (injected by src/dev/integration.mjs).
// Every font in the lab, set as real text in the site's colors. Buttons hand the
// choice to design mode; press D and Save to keep it.
import { readFile } from "node:fs/promises";
import { join } from "node:path";
import Base from "../layouts/Base.astro";
import { getPosts } from "../lib/content";
import { SITE } from "../site";

type Font = { family: string; role: string; by?: string; source?: string };
let fonts: Font[] = [];
try {
  fonts = JSON.parse(await readFile(join(process.cwd(), "src/dev/fonts/manifest.json"), "utf8"));
} catch {}

const FALLBACK: Record<string, string> = {
  display: "Impact, sans-serif",
  sans: '"Helvetica Neue", Arial, sans-serif',
  serif: "Georgia, serif",
  mono: "ui-monospace, Menlo, monospace",
};
const stack = (f: Font) => `"${f.family}", ${FALLBACK[f.role] ?? "sans-serif"}`;

// Sample text is yours: the newest post's title and opening.
const [post] = await getPosts();
const title = post?.data.title.replace(/[`*]/g, "") ?? "A title";
const body =
  post?.body
    ?.split(/\n\s*\n/)
    .find((p) => p.trim() && !p.startsWith("#") && !p.startsWith("!"))
    ?.replace(/[`*_]/g, "")
    .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1") ?? "";

const ROLES = [
  ["sans", "Sans: body text"],
  ["serif", "Serif: body text or headings"],
  ["display", "Display: logo and headings"],
  ["mono", "Mono: dates, nav, code"],
] as const;
---

<Base title="Font lab">
  <div class="prose lab-intro">
    <p>
      Every font in the lab ({fonts.length}), set in your colors. Each button sets that font for one slot. Then press{" "}
      <b>D</b>
      and <b>Save</b> to keep it, or <b>Reset</b> to undo.
    </p>
    <p class="mono">
      {ROLES.map(([r, label]) => <a href={`#${r}`}>{label.split(":")[0]}</a>)}
    </p>
    {fonts.length === 0 && <p class="mono">Font lab is empty: run mise run fonts.</p>}
  </div>

  {ROLES.map(([role, label]) => (
    <section id={role} class="lab-section">
      <h2 class="section-head">{label}</h2>
      <div class="lab-grid">
        {fonts
          .filter((f) => f.role === role)
          .map((f) => (
            <article class="lab-card" style={`--f: ${stack(f)}`}>
              <header class="mono">
                <a href={f.source}>{f.family}</a>
              </header>
              {role === "display" ? (
                <>
                  <p class="lab-logo">{SITE.logo}</p>
                  <p class="lab-title">{title}</p>
                </>
              ) : role === "mono" ? (
                <p class="lab-mono">
                  2026-02-02 &nbsp; WRITING &nbsp; PROJECTS
                  <br />
                  <code>buquet</code> · 08-28 · book · source ↗
                </p>
              ) : (
                <>
                  <p class="lab-title lab-title--current">{title}</p>
                  <p class="lab-body">{body}</p>
                  <p class="lab-body">
                    <b>Bold</b>, <i>italic</i>, 0123456789, “quotes” & ampersands.
                  </p>
                </>
              )}
              <div class="lab-use mono">
                {role !== "mono" && (
                  <button data-token="--body-font" data-value={stack(f)}>
                    body
                  </button>
                )}
                <button data-token="--heading-font" data-value={stack(f)}>
                  headings
                </button>
                {(role === "display" || role === "serif") && (
                  <button data-token="--logo-font" data-value={stack(f)}>
                    logo
                  </button>
                )}
                {role === "mono" && (
                  <button data-token="--mono-font" data-value={stack(f)}>
                    mono
                  </button>
                )}
              </div>
            </article>
          ))}
      </div>
    </section>
  ))}
</Base>

<script>
// Hand the choice to design mode (it keeps unsaved tweaks until Save/Reset).
document.addEventListener("click", (e) => {
  const b = (e.target as HTMLElement).closest<HTMLButtonElement>("button[data-token]");
  if (!b) return;
  dispatchEvent(new CustomEvent("dm:set", { detail: { name: b.dataset.token, value: b.dataset.value } }));
  document.querySelectorAll(`button[data-token="${b.dataset.token}"]`).forEach((x) => x.classList.remove("on"));
  b.classList.add("on");
});
</script>

<style>
.lab-intro {
  padding-bottom: 0;
}
.lab-intro .mono {
  display: flex;
  gap: var(--gutter);
}
.lab-section {
  margin-top: var(--section-gap);
}
.lab-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
  gap: var(--gutter);
  padding: var(--gutter);
}
.lab-card {
  display: flex;
  flex-direction: column;
  gap: 0.6em;
  padding: var(--gutter);
  border: var(--rule) solid var(--fg);
  content-visibility: auto;
  contain-intrinsic-size: auto 320px;
}
.lab-card header a {
  text-decoration: none;
}
.lab-card p {
  margin: 0;
}
.lab-logo {
  font-family: var(--f);
  font-size: 64px;
  line-height: 0.9;
  text-transform: uppercase;
}
.lab-title {
  font-family: var(--f);
  font-size: min(var(--h2-size), 28px);
  line-height: 1.05;
}
.lab-title--current {
  font-family: var(--heading-font);
  font-weight: var(--heading-weight);
}
.lab-body {
  font-family: var(--f);
  font-size: 1rem;
  line-height: var(--leading);
}
.lab-mono {
  font-family: var(--f);
  font-size: var(--small-size);
  line-height: 1.8;
  text-transform: none;
}
.lab-mono code {
  font-family: var(--f);
}
.lab-use {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-top: auto;
  padding-top: 0.6em;
}
.lab-use button {
  font: inherit;
  color: inherit;
  background: none;
  border: var(--rule) solid var(--fg);
  padding: 2px 10px;
  cursor: pointer;
}
.lab-use button:hover,
.lab-use button.on {
  background: var(--fg);
  color: var(--bg);
}
</style>
