---
import ProjectRows from "../components/ProjectRows.astro";
import Base from "../layouts/Base.astro";
import { getList } from "../lib/content";

const categories = Map.groupBy(await getList("projects"), (project) => project.data.category);
---

<Base title="Projects">
  {[...categories].map(([category, projects]) => (
    <section>
      <h2 class="section-head">{category}</h2>
      <ProjectRows projects={projects} />
    </section>
  ))}
</Base>
